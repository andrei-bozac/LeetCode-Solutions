class Solution {
public:
    bool areNumbersAscending(string s) {
        vector<int> res;
        int pos = 0;
        for(int i=0;i<s.length();i++){
            int num=0;
            if(isdigit(s[i])){
                if(isdigit(s[i+1])){
                    while(isdigit(s[i])){
                         num = num*10 + (s[i] - '0'); 
                         i++;
                    }
                }
             else num = num*10 + (s[i] - '0'); 
             res.push_back(num);
             if(pos>0 && res[pos]<=res[pos-1]) return false;
             pos++;
            }
          
            
            
        }
        return true;
    }
};
