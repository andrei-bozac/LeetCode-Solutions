class Solution {
public:
    bool canConstruct(string ransomNote, string magazine) {
        int rez=0;
        for(int i=0;i<ransomNote.length();i++){
            char c = ransomNote[i];
            bool found = false;
            for(int j=0;j<magazine.length();j++){
                if(magazine[j]==c){
                    found = true;
                    magazine[j]='.';
                    break;
                }
            }
            if(found==false) return false;
        }
        return true;
    }
};
