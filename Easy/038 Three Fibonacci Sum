class Solution {
public:
    bool threeFibonacciSum(int n) {
        vector<long long> fibo;
        long long a = 0;
        long long b = 1;
        long long temp = 0;
        fibo.push_back(a);
        fibo.push_back(b);
           while(b<=n){
             temp = a+b;
            a = b;
            b = temp;
            fibo.push_back(temp);
           }
           
        
        for(int i=0;i+2<fibo.size();i++){
            long long  sum = 0;
            sum = fibo[i]+fibo[i+1]+fibo[i+2];
            if(sum==n) return true;
        }
      return false;
    }
};
