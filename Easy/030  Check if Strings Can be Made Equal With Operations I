class Solution {
public:
    bool canBeEqual(string s1, string s2) {
        if(s1==s2) return true;
        for(int i=0;i<=2;i++){
            if(s1[i]!=s2[i])
           { char temp;
            temp = s1[i];
            s1[i] = s1[i+2];
            s1[i+2] = temp;}
            if(s1==s2) return true;
        }
        return false;
    }
};
