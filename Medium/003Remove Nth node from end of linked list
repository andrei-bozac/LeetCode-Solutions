class Solution {
public:
    ListNode* removeNthFromEnd(ListNode* head, int n) {
        int sz=0;
        ListNode* test=head;
        while(test!=nullptr){
            sz++;
            test=test->next;
        }
       int pos=sz-n;
       if(pos==0){
        ListNode* del = head->next;
        delete head;
        return del;
       }
       ListNode* current=head;
       for(int i=0;i<pos-1;i++){
            current=current->next;
       }
       ListNode* del = current->next;
       current->next=del->next;
       delete del;
       return head;
    }
};
