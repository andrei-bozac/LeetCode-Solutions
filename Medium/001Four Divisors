class Solution {
public:
    int sumFourDivisors(vector<int>& nums) {
        int sum=0;
        for(int i=0; i<nums.size();i++){
           int divisors=0;
           int divsum=0;
           for(int j=2;j<=nums[i]/2;j++){
                if(nums[i]%j==0){
                    divisors++;
                    divsum=divsum+j;
                   
                }
           }
           if(divisors==2){
            divsum=divsum+1+nums[i];
            sum=sum+divsum;
           }
        }
       return sum;
    }
};
