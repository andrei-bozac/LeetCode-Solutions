class Solution {
public:
    vector<int> searchRange(vector<int>& nums, int target) {
        if(nums.size()==1 && nums[0]==target) return {0,0};

        int first=-1;
        int last=-1;
        int cnt=0;

        for(int i=0;i<nums.size();i++){
            if(nums[i]==target){
                if(cnt==0){
                    first=i;
                    cnt++;
                } else{
                    last=i;
                }
            }
        }
        if(last==-1) last=first;
        return {first,last};
        
    }
};
