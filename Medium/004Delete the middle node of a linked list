class Solution {
public:
    ListNode* deleteMiddle(ListNode* head) {
        ListNode* temp = head;
        int nds=0;
        while(temp!=nullptr){
            nds++;
            temp=temp->next;
        }
        int pos=nds/2;
        ListNode* current = head;
        for(int i=0;i<pos-1;i++){
            current=current->next;
        }
        ListNode* del = current->next;
        current->next=del->next;
        delete del;
        return head;
    }
};
