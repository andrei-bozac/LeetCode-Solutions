class Solution {
public:
    vector<int> pivotArray(vector<int>& nums, int pivot) {
        std::vector<int> ans;
        std::vector<int> less;
        std::vector<int> equal;
        std::vector<int> greater;
        for(int i: nums){
            if(i<pivot) less.push_back(i);
            else if(i==pivot) equal.push_back(i);
            else greater.push_back(i);
        }
        ans.insert(ans.end(), less.begin(), less.end());
        ans.insert(ans.end(), equal.begin(), equal.end());
        ans.insert(ans.end(), greater.begin(), greater.end());
        return ans;
    }
};
